# Hemsidan: statiska filer, 404-sidan för okända sökvägar.
{
	admin off
	auto_https off
}
:{$PORT:8080} {
	# Domäner (öppen fråga 12): taxiavrakning.se till /taxi, akaravrakning.se till /akeri, www till utan www.
	@taxi host taxiavrakning.se www.taxiavrakning.se
	redir @taxi https://bolagsappar.se/taxi/ 301
	@akeri host akaravrakning.se www.akaravrakning.se
	redir @akeri https://bolagsappar.se/akeri/ 301
	@www host www.bolagsappar.se
	redir @www https://bolagsappar.se{uri} 301

	root * /srv
	encode zstd gzip
	header /_astro/* Cache-Control "public, max-age=31536000, immutable"
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
	file_server
	handle_errors {
		rewrite * /404.html
		file_server
	}
}
