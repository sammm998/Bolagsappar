# Hemsidan: statiska filer, 404-sidan för okända sökvägar.
{
	admin off
	auto_https off
}
:{$PORT:8080} {
	root * /srv
	encode zstd gzip
	header /_astro/* Cache-Control "public, max-age=31536000, immutable"
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
	file_server
	handle_errors {
		rewrite * /404.html
		file_server
	}
}
