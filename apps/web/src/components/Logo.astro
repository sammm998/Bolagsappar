---
// Loggan ur specifikationen, samma geometri som packages/ui (brand/geometry.ts).
import { LOGO_COLORS, LOGO_H, LOGO_W, SYMBOL, WORDMARK } from '@bolagsappar/ui/brand';
const { dark = false, size = 24, text = true } = Astro.props as { dark?: boolean; size?: number; text?: boolean };
const [c, g] = dark ? LOGO_COLORS.dark : LOGO_COLORS.light;
const w = text ? LOGO_W : LOGO_H;
---
<svg width={(w / LOGO_H) * size} height={size} viewBox={`0 0 ${w} ${LOGO_H}`} role="img" aria-label="bolagsappar" style="display:block">
  {SYMBOL.map((d, i) => <path d={d} fill={i === 3 ? g : c} />)}
  {text && <path d={WORDMARK} fill={c} />}
</svg>
