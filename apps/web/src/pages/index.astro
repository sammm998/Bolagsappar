---
import Base from '../layouts/Base.astro';
import AvrScreen from '../components/AvrScreen.astro';
import { BRANSCHER } from '../lib/site';
const FAQ = [
  ['Behöver vi veta vad vi vill ha?', 'Nej. Ni behöver bara visa hur ni jobbar i dag. Vi skriver ner flödet med era ord och bygger efter det.'],
  ['Vad kostar arbetsdagen?', 'Ingenting. Efteråt får ni ett förslag med fast månadspris. Säger ni nej har ni ändå fått en karta över hur ni jobbar.'],
  ['Var finns vår data?', 'I Sverige och EU. Varje konto ser bara sin egen data. Våra utvecklare ser den bara om ni ger tillgång, och allt de gör då loggas hos er.'],
  ['Hur loggar man in?', 'Med en inloggningslänk till e-posten. Avtal signeras med pennan, man ritar sin underskrift med fingret i mobilen.'],
  ['Vad händer om vi vill sluta?', 'Ni säger upp med [uppsägningstid]. Ni får med er all data i Excel och PDF.']
];
---
<Base title="Bolagsappar" description="Vi lär oss hur ni jobbar på en dag. Appen är klar inom två veckor. Fast månadspris, ingen IT-avdelning behövs.">
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <p class="eyebrow">Appar för företag som fastnat i Excel och mejl</p>
        <h1>Vi lär oss hur ni jobbar på en dag. <em>Appen är klar inom två veckor.</em></h1>
        <p class="lead">Fast månadspris. Ingen IT-avdelning behövs. Vi bygger verktyget som passar ert sätt att jobba, och sköter det åt er.</p>
        <div class="btns"><a class="btn btn--primary" href="/boka">Boka en arbetsdag</a><a class="btn btn--ghost" href="/kundcase/taxi-malmo">Se hur det gick för Taxi Malmö</a></div>
        <ul class="trust"><li>Ingen startavgift</li><li>Data i Sverige och EU</li><li>Inloggning med e-postlänk</li></ul>
      </div>
      <div class="days">
        <div class="day"><b>DAG 1</b>Vi sitter med er en dag och ser hur det går till.</div>
        <AvrScreen />
        <div class="day"><b>DAG 14</b>Appen är igång med era egna filer och flöden.</div>
      </div>
    </div>
  </section>

  <section class="sec sec--white" id="sa-jobbar-vi">
    <div class="wrap">
      <div class="sec-head"><div><p class="eyebrow">Så jobbar vi</p><h2>Från rörigt till rätt på fjorton dagar</h2></div><p class="lead" style="margin:0;max-width:24em">Ni behöver inte veta vad ni vill ha. Ni behöver bara visa hur ni jobbar.</p></div>
      <div class="grid grid--3">
        <div class="card"><div class="step-n">1</div><h3>En dag hos er</h3><p>Vi sitter bredvid och ser hur det går till i dag. Excel, mejl, pärmar och system. Vi skriver ner flödet med era ord.</p></div>
        <div class="card"><div class="step-n">2</div><h3>Två veckor senare</h3><p>Ni testar en fungerande app med era riktiga filer. Vi justerar tills den sitter, utan extra kostnad.</p></div>
        <div class="card"><div class="step-n">3</div><h3>Sedan sköter vi den</h3><p>Fast pris per månad. Drift, säkerhet, uppdateringar och support ingår. Nya behov blir nya appar.</p></div>
      </div>
    </div>
  </section>

  <section class="sec" id="branscher">
    <div class="wrap">
      <div class="sec-head"><div><p class="eyebrow">Branscher</p><h2>Byggt för riktiga företag</h2></div><a class="btn btn--ghost btn--sm" href="/kundcase">Alla kundcase</a></div>
      <div class="grid grid--4">
        {BRANSCHER.map(b => <a class="card card--link" href={'/' + b.slug}><h3>{b.namn}</h3><p>{b.kort}</p><span class="more">Läs mer</span></a>)}
      </div>
    </div>
  </section>

  <section class="sec sec--white" id="huvudkunder">
    <div class="wrap price">
      <div>
        <p class="eyebrow">För huvudkunder</p>
        <h2>Ge era åkare och underleverantörer samma appar.</h2>
        <p class="lead">Ni bestämmer vilka appar som ingår och vem som betalar. Varje åkare får sin egen inloggning, sin egen data och er avräkning direkt i mobilen.</p>
        <div class="btns"><a class="btn btn--ghost" href="/boka">Prata med oss om huvudkundsavtal</a></div>
      </div>
      <div class="screen" role="img" aria-label="Taxi Malmö och tre av åkarna med sina appar">
        <div class="screen-head"><span class="av">TM</span><b>Taxi Malmö</b><span class="muted small" style="margin-left:auto">Huvudkund · Avräkning, Förarlista</span></div>
        <div class="screen-body"><ul class="rows" style="margin:0">
          <li><span>Åkeri Norra AB</span><span class="small muted">Min avräkning</span><span class="small muted">Åkarkassan</span></li>
          <li><span>Limhamn Trafik AB</span><span class="small muted">Min avräkning</span><span></span></li>
          <li><span>Söder Taxi HB</span><span class="small muted">Min avräkning</span><span class="small muted">Åkarkassan</span></li>
        </ul></div>
      </div>
    </div>
  </section>

  <section class="sec" id="pris">
    <div class="wrap price">
      <div><p class="eyebrow">Pris</p><h2>Ett pris per månad. Inga överraskningar.</h2><p class="lead">Ni betalar inte för timmar. Ni betalar för ett verktyg som fungerar varje månad.</p></div>
      <div class="price-card">
        <div class="small muted">Från</div>
        <div class="amount">[PRIS]</div>
        <div class="small muted">kr per månad, exkl. moms</div>
        <ul class="checks"><li>Arbetsdag och kartläggning</li><li>App byggd för ert flöde</li><li>Inloggning med e-postlänk för alla, signering med pennan</li><li>Drift, säkerhet och säkerhetskopior</li><li>Support på svenska</li><li>Nya funktioner när ni behöver dem</li></ul>
        <div class="btns"><a class="btn btn--primary" href="/boka">Boka en arbetsdag</a></div>
      </div>
    </div>
  </section>

  <section class="sec sec--white" id="fragor">
    <div class="wrap price">
      <div><p class="eyebrow">Vanliga frågor</p><h2>Det ni brukar undra</h2></div>
      <div class="faq">{FAQ.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}</div>
    </div>
  </section>
</Base>
